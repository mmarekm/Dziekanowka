@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
@inject LadowanieGracza ladowanieGracza
<div class="stajennyWidok widok rel">
    <div class="abs stajennyDoStajnia"><button @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Stajnia)" class="wyroznionyGuzik"><img src="img/zwierzyniec/stajennyDoStajnia.png" /></button></div>
    <div class="abs kiosk1Puchar @(Gracz.Statystyki.MoznaOdebracObraz ? "poblyskuje" : "")"><img src="img/przedmioty/medalRestauracyjny@(sciezkaPucharu)Zdobyty.png" /></div>
    @if (Gracz.Statystyki.AktualnaMisja == Misje.Stajenny)
    {
        <div class="abs potrzebneStajennemu @(jestCiasto ? "klikalneDivZielone" : "nieMoznaKliknac")" @onclick="DajCiasto"></div>
        <div class="abs elementyDlaStajennego">3 <img class="obrazekContain" src="img/przedmioty/siano.png" /><img class="obrazekContain" src="img/dom/kuchnia/ciasto/@(Gracz.Statystyki.DaneMisji[0]).png" /></div>
    }
    <div class="abs @KlasaPowitania"><img class="obrazekSieMiesci" src="img/dom/kuchnia/krowaMleko.png" /><img class="obrazekSieMiesci" src="img/dom/kuchnia/owcaMleko.png" /><img class="obrazekSieMiesci" src="img/dom/kuchnia/kozaMleko.png" /></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    protected override async Task OnInitializedAsync()
    {
        if (Gracz.Statystyki.OtwarteOkno == "mlekoOdStajennego")
        {
            Gracz.Statystyki.OtwarteOkno = "";
            Powitaj = true;
            Znikanie = false;
            StateHasChanged();
            await Task.Delay(100);
            Znikanie = true;
            StateHasChanged();
            await Task.Delay(7000);
            Powitaj = false;
            Znikanie = false;
            StateHasChanged();
        }
    }
    private bool Powitaj { get; set; } = false;
    private bool Znikanie { get; set; } = false;
    private string KlasaPowitania => Powitaj ? (Znikanie ? "powitanieDzienne zanikaj" : "powitanieDzienne") : "ukryty";
    private string sciezkaPucharu => Gracz.Statystyki.MoznaOdebracObraz ? "" : "Nie";
    private bool jestCiasto => Gracz.Statystyki.AktualnaMisja == Misje.Stajenny && Gracz.JestProduktP(Gracz.Statystyki.DaneMisji[0]) && Gracz.JestPrzedmiot("siano") && Gracz.Przedmiot("siano").Ilosc > 2;
    private async Task DajCiasto()
    {
        if (!jestCiasto) return;
        Gracz.ProduktP(Gracz.Statystyki.DaneMisji[0]).Ilosc--;
        Gracz.Przedmiot("siano").Ilosc -= 3;
        Gracz.ProduktZ("krowaMleko").Ilosc++;
        Gracz.ProduktZ("kozaMleko").Ilosc++;
        Gracz.ProduktZ("owcaMleko").Ilosc++;
        Gracz.Statystyki.MoznaOdebracObraz = true;
        Gracz.Statystyki.DaneMisji = [Gra.ZbiorChlopiecMiska[Random.Shared.Next(Gra.ZbiorChlopiecMiska.Count)], "", ""];
        Gracz.Statystyki.AktualnaMisja = Misje.Chlopiec;
        Gracz.Statystyki.OtwarteOkno = "mlekoOdStajennego";
        await NaZmianeEkranu.InvokeAsync(EkranGry.CiastoDlaStajennego);
        await Task.Delay(7700);
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stajenny);
        await ladowanieGracza.ZapiszAktualnegoGracza();
    }
}