@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
@inject LadowanieGracza ladowanieGracza
<div class="lasIntroWidok widok rel">
    <div class="abs lasDoZaBrama" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.ZaBrama)"><button class="wyroznionyGuzik niewidzialnyPrzycisk"></button></div>
    <div class="abs lasDoKarczowiska" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.LasKarczowisko)"><button class="wyroznionyGuzik niewidzialnyPrzycisk"></button></div>
    <div class="abs lasDoJeziora" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.LasJezioro)"><button class="wyroznionyGuzik niewidzialnyPrzycisk"></button></div>
    <div class="abs lasIntroDoLas1" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Las1)"><button class="wyroznionyGuzik niewidzialnyPrzycisk"></button></div>
    <div class="abs lasNaGrzyby @(Gracz.Monety > 1 ? "klikalneDivZielone" : "nieMoznaKliknac")" @onclick="NaGrzyby"></div>
    <div class="abs lMonetLasIntro dCenter">@Gracz.Monety<img class="obrazekJakTrzeba" src="img/przedmioty/moneta.png" /></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private async Task NaGrzyby()
    {
        if (Gracz.Monety < 2) return;
        Gracz.Monety -= 2;
        await ladowanieGracza.ZapiszAktualnegoGracza();
        await NaZmianeEkranu.InvokeAsync(EkranGry.LasGrzyby);
    }
}