    <div class="abs las2DoLas4"><button @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Las4)" class="wyroznionyGuzik"><img src='img/teren/las/las2DoLas4.png' /></button></div>
    <div class="abs las2DoLas5"><button @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Las5)" class="wyroznionyGuzik"><img src='img/teren/las/las2DoLas5.png' /></button></div>
