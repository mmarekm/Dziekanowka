@using Dziekanowka.Mechanizm
<div class="widok powitanie rel">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/teren/zaBramaWidok.mp4" type="video/mp4" /></video>
    <div class="abs powrotDoDomuGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Gospodarstwo)"><button class="wyroznionyGuzik niewidzialnyPrzycisk"></button></div>
    <div class="abs doSklepikuGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Sklepik)"><button class="wyroznionyGuzik niewidzialnyPrzycisk"></button></div>
    <div class="abs zaBramaDoMiastoGuzik" @onclick="DoMiasta"><button class="wyroznionyGuzik niewidzialnyPrzycisk"></button></div>
    <div class="abs doSasiadaGuzik" @onclick="DoSasiada"><button class="wyroznionyGuzik niewidzialnyPrzycisk"></button></div>
    <div class="abs zaBramaDoLas" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.LasIntro)"><button class="wyroznionyGuzik niewidzialnyPrzycisk"></button></div>
    <div class="abs stanPaliwaZaBrama">
        <div class="kanisterGarazGospodarczy"><img class="obrazekWypelnia" src="img/przedmioty/kanister.png" /></div>
        <progress class="pasekPaliwa" value="@Gracz.Paliwo.IloscPaliwa" max="@Gracz.Paliwo.MaksymalnaIloscPaliwa" style="--procent: @((int)((double)Gracz.Paliwo.IloscPaliwa / Gracz.Paliwo.MaksymalnaIloscPaliwa * 100) / 10) "></progress>
    </div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    public async Task DoSasiada()
    {
        await NaZmianeEkranu.InvokeAsync(EkranGry.PsySasiadaSzczekaja);
        await Task.Delay(5000);
        await NaZmianeEkranu.InvokeAsync(EkranGry.ZaBrama);
    }
    public async Task DoMiasta()
    {
        if (Gracz.Paliwo.IloscPaliwa < 1) return;
        Gracz.Paliwo.IloscPaliwa--;
        await NaZmianeEkranu.InvokeAsync(EkranGry.SamochodDoMiasta);
        await Task.Delay(5000);
        await NaZmianeEkranu.InvokeAsync(EkranGry.Miasto1);
    }
}