                <div class="abs kolumnaRozkladu kolumnaRozkladu1">
                    @foreach (var rozklad in listaRozkladu.Take(polowa))
                    {
                        <div class="rozkladPociagu2">
                            <div><img class="obrazekContain wiekszyLabelPociagu" src="img/miasto/stacje/@rozklad.obrazek" /></div>
                            @for (int i = 0; i < rozklad.godziny.Length; i++)
                            {
                                <div>@rozklad.godziny[i]</div>
                            }
                        </div>
                    }
                </div>
                <div class="abs kolumnaRozkladu kolumnaRozkladu2">
                    @foreach (var rozklad in listaRozkladu.Skip(polowa))
                    {
                        <div class="rozkladPociagu2">
                            <div><img class="obrazekContain wiekszyLabelPociagu" src="img/miasto/stacje/@rozklad.obrazek" /></div>
                            @for (int i = 0; i < rozklad.godziny.Length; i++)
                            {
                                <div>@rozklad.godziny[i]</div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                @foreach (var rozklad in AktualnyRozklad())
                {
                    <div class="rozkladPociagu1">
                        <div><img src="img/miasto/stacje/@rozklad.obrazek" /></div>
                        @for (int i = 0; i < rozklad.godziny.Length; i++)
                        {
                            <div>@rozklad.godziny[i]</div>
                        }
                    </div>
                }
                @if (stacja == "miastoGorskie" && Gracz.Statystyki.Bonusy.Contains("pociagZGor"))
                {
                    <div class="rozkladPociagu1"><div><img class="labelCzarnegoPociagu" src="img/miasto/pociagCzarny.png" /></div><div>78</div></div>
                }
            }
        </div>
        <div class="abs zamknijRozklady"><button class="wyroznionyGuzik" @onclick="() => wyswietlonyRozklad = false"><img class="obrazekContain" src="img/dom/potwierdzenie.png" /></button></div>
    </div>
}
@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private CancellationTokenSource? _ctsZegar;
    private string stacja => Gracz.Statystyki.Stacja;
    private int czas = 0;
    private bool wyswietlonyRozklad = false;
    private Dictionary<int, (string klasa, bool moznaWsiasc)> pociagi = Enumerable.Range(1, 49).ToDictionary(nr => nr, _ => ("", false));
    private bool CzyMetropolia => BazaPociagow.CzyMetropolia(stacja);
    private IEnumerable<(string obrazek, int[] godziny)> AktualnyRozklad() => BazaPociagow.AktualnyRozklad(stacja);
    private string KlasaAnimacji(int nr) => $"pociag{nr}{stacja}Animacja";
    protected override void OnParametersSet()
    {
        AktualizujPociagi();
        if (_ctsZegar == null)
        {
            _ctsZegar = new CancellationTokenSource();
            _ = Zegar(_ctsZegar.Token);
        }
    }
    private async Task Zegar(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(800, token);
                czas = (czas + 1) % 100;
                AktualizujPociagi();
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }
    private void AktualizujPociagi()
    {
        if (!BazaPociagow.PociagiZeStacji.TryGetValue(stacja, out var numery)) return;
        foreach (var nr in numery)
            pociagi[nr] = StanPociagu($"pociag{nr}", BazaPociagow.OdjazdyPociagu[nr]);
    }
    private async Task KupBilet()
    {
        if (Gracz.Monety < BazaPociagow.CenaBiletu(stacja)) return;
        Gracz.Monety -= BazaPociagow.CenaBiletu(stacja);
        Gracz.Przedmiot("biletPociag").Ilosc++;
        await ladowanieGracza.ZapiszAktualnegoGracza();
    }
    public async Task WsiadzDoPociagu(int nrPociagu)
    {
        if (Gracz.Przedmiot("biletPociag").Ilosc < 1 || !pociagi[nrPociagu].moznaWsiasc) return;
        Gracz.Przedmiot("biletPociag").Ilosc--;
        czas = 0;
        Gracz.Statystyki.Stacja = BazaPociagow.CelPociagu(nrPociagu);
        if (nrPociagu == 27)
        {
            Gracz.Statystyki.Bonusy.Remove("pociagZGor");
            await NaZmianeEkranu.InvokeAsync(EkranGry.PociagCzarnyDoTunelu);
            await Task.Delay(8000);
            await NaZmianeEkranu.InvokeAsync(EkranGry.StacjaJaskinia);
        }
        else if (nrPociagu == 45)
        {
            await NaZmianeEkranu.InvokeAsync(EkranGry.WjazdStacjaKopalnie);
            await Task.Delay(10000);
            await NaZmianeEkranu.InvokeAsync(EkranGry.StacjaKopalnie);
        }
        else
        {
            await NaZmianeEkranu.InvokeAsync(EkranGry.PociagJedzie);
            await Task.Delay(7000);
            await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
        }
        await ladowanieGracza.ZapiszAktualnegoGracza();
    }
    private (string, bool) StanPociagu(string nazwa, int[] rozklad)
    {
        foreach (var odjazd in rozklad)
        {
            var offset = (czas - odjazd + 100) % 100;
            if (offset is 97 or 98 or 99)
                return ("kazdyPociagJedzie", false);
            if (offset is 0 or 1 or 2)
                return ("kazdyPociagStoi", true);
            if (offset is 3 or 4 or 5)
                return ($"kazdyPociagOdjedzie {BazaPociagow.StronaOdjazdu(nazwa, stacja)}", false);
        }
        return ($"kazdyPociagUkryty {BazaPociagow.StronaPrzyjazdu(nazwa, stacja)}", false);
    }
    public void Dispose()
    {
        _ctsZegar?.Cancel();
    }
}