@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private CancellationTokenSource? _ctsZegar;
    private string stacja => Gracz.Statystyki.Stacja;
    private int czas = 0;
    private bool wyswietlonyRozklad = false;
    private int[] odjazdyMiasto3DoMiastaLesnego = [10, 30, 40, 60, 90];
    private int[] odjazdyMiasto3DoMiastoBiale = [15, 45, 75];
    private int[] odjazdyMiasto3DoMiastaMorskiego = [35];
    private int[] odjazdyMiasto3DoMetropolii1 = [20, 50, 70, 80];
    private int[] odjazdyMiastoLesneDoMiasta3 = [10, 30, 55, 85];
    private int[] odjazdyMiastoLesneDoMiastoBiale = [50];
    private int[] odjazdyMiastoLesneDoMiastoMorskie = [15, 40, 75];
    private int[] odjazdyMiastoLesneDoMetropolii1 = [20, 40, 65, 75];
    private int[] odjazdyMiastoBialeDoMiasta3 = [10, 20, 40, 80];
    private int[] odjazdyMiastoBialeDoMiastoLesne = [45];
    private int[] odjazdyMiastoBialeDoMiastoMorskie = [15, 35, 75];
    private int[] odjazdyMiastoBialeDoMiastoGorskie = [30, 70];
    private int[] odjazdyMiastoBialeDoMetropolii1 = [5, 25, 55, 85];
    private int[] odjazdyMiastoMorskieDoMiastoLesne = [10, 43, 76];
    private int[] odjazdyMiastoMorskieDoMiastoBiale = [28, 56, 90];
    private int[] odjazdyMiastoMorskieDoMetropolii1 = [19, 65, 85];
    private int[] odjazdyMiastoGorskieDoMiasta3 = [18, 38, 58, 88];
    private int[] odjazdyMiastoGorskieDoMiastoMorskie = [48];
    private int[] odjazdyMiastoGorskieDoMetropolii1 = [8, 28, 68];
    private int[] odjazdyMiastoGorskiePociagCzarny = [78];
    private int[] odjazdyMetropolia1DoMiasta3 = [8, 26, 44, 62, 80];
    private int[] odjazdyMetropolia1DoMiastoLesne = [12, 37, 62, 87];
    private int[] odjazdyMetropolia1DoMiastoBiale = [25, 50, 75, 95];
    private int[] odjazdyMetropolia1DoMiastoMorskie = [16, 49, 83];
    private int[] odjazdyMetropolia1DoMiastoGorskie = [33, 64, 92];
    private int[] odjazdyMetropolia1DoMiastoWiejskie = [30, 82];
    private int[] odjazdyMiastoWiejskieDoMetropolii1 = [40, 77];
    private Dictionary<int, (string klasa, bool moznaWsiasc)> pociagi = new()
    {
        {1, ("", false)}, {2, ("", false)}, {3, ("", false)}, {4, ("", false)}, {5, ("", false)}, {6, ("", false)}, {7, ("", false)}, {8, ("", false)}, {9, ("", false)}, {10, ("", false)},
        {11, ("", false)}, {12, ("", false)}, {13, ("", false)}, {14, ("", false)}, {15, ("", false)}, {16, ("", false)}, {17, ("", false)}, {18, ("", false)}, {19, ("", false)}, {20, ("", false)},
        {21, ("", false)}, {22, ("", false)}, {23, ("", false)}, {24, ("", false)}, {25, ("", false)}, {26, ("", false)}, {27, ("", false)}
    };
    private bool CzyMetropolia => stacja == "metropolia1";
    private IEnumerable<(string obrazek, int[] godziny)> AktualnyRozklad()
    {
        return stacja switch
        {
            "miasto3" => [("miastoLesneLabel.png", odjazdyMiasto3DoMiastaLesnego), ("miastoBialeLabel.png", odjazdyMiasto3DoMiastoBiale), ("miastoMorskieLabel.png", odjazdyMiasto3DoMiastaMorskiego), ("metropolia1Label.png", odjazdyMiasto3DoMetropolii1)],
            "miastoLesne" => [("miasto3Label.png", odjazdyMiastoLesneDoMiasta3), ("miastoBialeLabel.png", odjazdyMiastoLesneDoMiastoBiale), ("miastoMorskieLabel.png", odjazdyMiastoLesneDoMiastoMorskie), ("metropolia1Label.png", odjazdyMiastoLesneDoMetropolii1)],
            "miastoBiale" => [("miasto3Label.png", odjazdyMiastoBialeDoMiasta3), ("miastoLesneLabel.png", odjazdyMiastoBialeDoMiastoLesne), ("miastoMorskieLabel.png", odjazdyMiastoBialeDoMiastoMorskie), ("miastoGorskieLabel.png", odjazdyMiastoBialeDoMiastoGorskie), ("metropolia1Label.png", odjazdyMiastoBialeDoMetropolii1)],
            "miastoMorskie" => [("miastoLesneLabel.png", odjazdyMiastoMorskieDoMiastoLesne), ("miastoBialeLabel.png", odjazdyMiastoMorskieDoMiastoBiale), ("metropolia1Label.png", odjazdyMiastoMorskieDoMetropolii1)],
            "miastoGorskie" => [("miasto3Label.png", odjazdyMiastoGorskieDoMiasta3), ("miastoMorskieLabel.png", odjazdyMiastoGorskieDoMiastoMorskie), ("metropolia1Label.png", odjazdyMiastoGorskieDoMetropolii1)],
            "miastoWiejskie" => [("metropolia1Label.png", odjazdyMiastoWiejskieDoMetropolii1)],
            "metropolia1" => [("miasto3Label.png", odjazdyMetropolia1DoMiasta3), ("miastoLesneLabel.png", odjazdyMetropolia1DoMiastoLesne), ("miastoBialeLabel.png", odjazdyMetropolia1DoMiastoBiale), ("miastoMorskieLabel.png", odjazdyMetropolia1DoMiastoMorskie), ("miastoGorskieLabel.png", odjazdyMetropolia1DoMiastoGorskie), ("miastoWiejskieLabel.png", odjazdyMetropolia1DoMiastoWiejskie)],
            _ => []
        };
    }
    protected override void OnParametersSet()
    {
        AktualizujPociagi();
        if (_ctsZegar == null)
        {
            _ctsZegar = new CancellationTokenSource();
            _ = Zegar(_ctsZegar.Token);
        }
    }
    private async Task Zegar(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(800, token);
                czas = (czas + 1) % 100;
                AktualizujPociagi();
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }
    private void AktualizujPociagi()
    {
        if (stacja == "miasto3")
        {
            pociagi[1] = StanPociagu("pociag1", odjazdyMiasto3DoMiastaLesnego);
            pociagi[3] = StanPociagu("pociag3", odjazdyMiasto3DoMiastoBiale);
            pociagi[7] = StanPociagu("pociag7", odjazdyMiasto3DoMiastaMorskiego);
            pociagi[15] = StanPociagu("pociag15", odjazdyMiasto3DoMetropolii1);
        }
        if (stacja == "miastoLesne")
        {
            pociagi[2] = StanPociagu("pociag2", odjazdyMiastoLesneDoMiasta3);
            pociagi[5] = StanPociagu("pociag5", odjazdyMiastoLesneDoMiastoBiale);
            pociagi[8] = StanPociagu("pociag8", odjazdyMiastoLesneDoMiastoMorskie);
            pociagi[17] = StanPociagu("pociag17", odjazdyMiastoLesneDoMetropolii1);
        }
        if (stacja == "miastoBiale")
        {
            pociagi[4] = StanPociagu("pociag4", odjazdyMiastoBialeDoMiasta3);
            pociagi[6] = StanPociagu("pociag6", odjazdyMiastoBialeDoMiastoLesne);
            pociagi[9] = StanPociagu("pociag9", odjazdyMiastoBialeDoMiastoMorskie);
            pociagi[12] = StanPociagu("pociag12", odjazdyMiastoBialeDoMiastoGorskie);
            pociagi[19] = StanPociagu("pociag19", odjazdyMiastoBialeDoMetropolii1);
        }
        if (stacja == "miastoMorskie")
        {
            pociagi[10] = StanPociagu("pociag10", odjazdyMiastoMorskieDoMiastoLesne);
            pociagi[11] = StanPociagu("pociag11", odjazdyMiastoMorskieDoMiastoBiale);
            pociagi[21] = StanPociagu("pociag21", odjazdyMiastoMorskieDoMetropolii1);
        }
        if (stacja == "miastoGorskie")
        {
            pociagi[13] = StanPociagu("pociag13", odjazdyMiastoGorskieDoMiasta3);
            pociagi[14] = StanPociagu("pociag14", odjazdyMiastoGorskieDoMiastoMorskie);
            pociagi[23] = StanPociagu("pociag23", odjazdyMiastoGorskieDoMetropolii1);
            pociagi[27] = StanPociagu("pociag27", odjazdyMiastoGorskiePociagCzarny);
        }
        if (stacja == "miastoWiejskie")
        {
            pociagi[26] = StanPociagu("pociag26", odjazdyMiastoWiejskieDoMetropolii1);
        }
        if (stacja == "metropolia1")
        {
            pociagi[16] = StanPociagu("pociag16", odjazdyMetropolia1DoMiasta3);
            pociagi[18] = StanPociagu("pociag18", odjazdyMetropolia1DoMiastoLesne);
            pociagi[20] = StanPociagu("pociag20", odjazdyMetropolia1DoMiastoBiale);
            pociagi[22] = StanPociagu("pociag22", odjazdyMetropolia1DoMiastoMorskie);
            pociagi[24] = StanPociagu("pociag24", odjazdyMetropolia1DoMiastoGorskie);
            pociagi[25] = StanPociagu("pociag25", odjazdyMetropolia1DoMiastoWiejskie);
        }
    }
    private EkranGry Wyjscie => stacja switch { "miasto3" => EkranGry.Miasto3, "miastoLesne" => EkranGry.MiastoLesne, "miastoBiale" => EkranGry.MiastoBiale, "miastoMorskie" => EkranGry.MiastoMorskie, "miastoGorskie" => EkranGry.MiastoGorskie, "miastoWiejskie" => EkranGry.MiastoWiejskie, _ => throw new ArgumentOutOfRangeException() };
    private string CelPociagu(int nrPociagu) => nrPociagu switch { 1 or 6 or 10 or 18 => "miastoLesne", 2 or 4 or 13 or 16 => "miasto3", 3 or 5 or 11 or 20 => "miastoBiale", 7 or 8 or 9 or 14 or 22 => "miastoMorskie", 12 or 24 or 27 => "miastoGorskie", 25 => "miastoWiejskie", 15 or 17 or 19 or 21 or 23 or 26 => "metropolia1",  _ => throw new ArgumentOutOfRangeException() };
    private int cenaBiletu => stacja is "miasto3" or "miastoMorskie" ? 7 : stacja is "metropolia1" ? 6 : 10;
    private async Task KupBilet()
    {
        if (Gracz.Monety < cenaBiletu) return;
        Gracz.Monety -= cenaBiletu;
        Gracz.Przedmiot("biletPociag").Ilosc++;
        await ladowanieGracza.ZapiszAktualnegoGracza();
    }
    public async Task WsiadzDoPociagu(int nrPociagu)
    {
        if (Gracz.Przedmiot("biletPociag").Ilosc < 1 || !pociagi[nrPociagu].moznaWsiasc) return;
        Gracz.Przedmiot("biletPociag").Ilosc--;
        czas = 0;
        Gracz.Statystyki.Stacja = CelPociagu(nrPociagu);
        if (nrPociagu == 27)
        {
            await NaZmianeEkranu.InvokeAsync(EkranGry.StacjaJaskinia);
        }
        else
        {
            await NaZmianeEkranu.InvokeAsync(EkranGry.PociagJedzie);
            await Task.Delay(7000);
            await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
            await ladowanieGracza.ZapiszAktualnegoGracza();
        }
    }
    private string StronaPrzyjazdu(string nazwa) => PrawyTor(nazwa) ? "pociagNaPrawo" : "pociagNaLewo";
    private string StronaOdjazdu(string nazwa) => PrawyTor(nazwa) ? "pociagNaLewo" : "pociagNaPrawo";
    private bool PrawyTor(string nazwa)
    {
        return (nazwa, stacja) switch
        {
            ("pociag1", "miasto3") => true,
            ("pociag15", "miasto3") => true,
            ("pociag5", "miastoLesne") => true,
            ("pociag8", "miastoLesne") => true,
            ("pociag4", "miastoBiale") => true,
            ("pociag12", "miastoBiale") => true,
            ("pociag22", "metropolia1") => true,
            ("pociag24", "metropolia1") => true,
            ("pociag25", "metropolia1") => true,
            _ => false
        };
    }
    private (string, bool) StanPociagu(string nazwa, int[] rozklad)
    {
        foreach (var odjazd in rozklad)
        {
            var offset = (czas - odjazd + 100) % 100;
            if (offset is 97 or 98 or 99)
                return ("kazdyPociagJedzie", false);
            if (offset is 0 or 1 or 2)
                return ("kazdyPociagStoi", true);
            if (offset is 3 or 4 or 5)
                return ($"kazdyPociagOdjedzie {StronaOdjazdu(nazwa)}", false);
        }
        return ($"kazdyPociagUkryty {StronaPrzyjazdu(nazwa)}", false);
    }
    public void Dispose()
    {
        _ctsZegar?.Cancel();
    }
