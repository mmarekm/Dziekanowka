@using Dziekanowka.Mechanizm
<div class="widok powitanie rel">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/miasto/biblioteka/bibliotekaIntroWidok.mp4" type="video/mp4" /></video>
    <div class="abs celBiblioteka bibliotekaDoMiasto"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Miasto2)"><img class="obrazekJakTrzeba" src="img/miasto/biblioteka/strzalkaBiblioteka.png" /></button></div>
    <div class="abs celBiblioteka bibliotekaDoCzytelnia"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.BibliotekaCzytelnia)"><img class="obrazekJakTrzeba" src="img/miasto/biblioteka/strzalkaBiblioteka.png" /></button></div>
    <div class="abs celBiblioteka bibliotekaDoGalerii"><button class="wyroznionyGuzik" @onclick="DoGalerii"><img class="obrazekJakTrzeba" src="img/miasto/biblioteka/strzalkaBiblioteka.png" /></button></div>
    <div class="abs celBiblioteka bibliotekaDoPani"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.BibliotekaPani)"><img class="obrazekJakTrzeba" src="img/miasto/biblioteka/strzalkaBiblioteka.png" /></button></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private async Task DoGalerii()
    {
        await NaZmianeEkranu.InvokeAsync(EkranGry.WejscieDoGalerii);
        await Task.Delay(5900);
        await NaZmianeEkranu.InvokeAsync(EkranGry.BibliotekaGaleria);
    }
}