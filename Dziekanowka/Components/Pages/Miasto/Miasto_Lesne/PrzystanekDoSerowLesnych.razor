@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
@inject LadowanieGracza ladowanieGracza
<div class="widok rel" style="background-image: url('../img/miasto/miastoLesneDoSery/przystanek@(zwierze)Widok.png');">
    <div class="abs powrotZPrzystankuDoMiastaLesnego" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.MiastoLesne)"></div>
    <div class="abs pokarmNaPrzystankuDoSerowLesnych pokarm1NaPrzystankuDoSerowLesnych @(JestPokarm1() ? "pokarmNaPrzystankuDoSerowLesnychJest" : "pokarmNaPrzystankuDoSerowLesnychNieMa")" @onclick="Karm1IJedzDalej">2 <img src="@SciezkaDoPokarmu1()" class="obrazekSieMiesci" /></div>
    @if (zwierze != "koń")
    {
        <div class="abs pokarmNaPrzystankuDoSerowLesnych pokarm2NaPrzystankuDoSerowLesnych @(JestPokarm2() ? "pokarmNaPrzystankuDoSerowLesnychJest" : "pokarmNaPrzystankuDoSerowLesnychNieMa")" @onclick="Karm2IJedzDalej">2 <img src="@SciezkaDoPokarmu2()" class="obrazekSieMiesci" /></div>
    }
    @if (zwierze != "koń" && zwierze != "słoń" && zwierze != "żyrafa")
    {
        <div class="abs pokarmNaPrzystankuDoSerowLesnych pokarm3NaPrzystankuDoSerowLesnych @(JestPokarm3() ? "pokarmNaPrzystankuDoSerowLesnychJest" : "pokarmNaPrzystankuDoSerowLesnychNieMa")" @onclick="Karm3IJedzDalej">2 <img src="@SciezkaDoPokarmu3()" class="obrazekSieMiesci" /></div>
    }
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private string zwierze => Gracz.Statystyki.ZwierzeNaDrodze;
    private string[] warzywa = ["brokuł", "por", "brukselka", "rzodkiewka", "szpinak", "burak", "kapustaPekińska", "dynia", "sorgo", "selerNaciowy"];
    private string[] owoce = ["arbuz", "mango"];
    private string[] zboza = ["gryka"];
    private string pokarm1 => zwierze == "krowa" ? "brokuł" : zwierze == "koń" ? "siano" : zwierze == "owca" ? "brukselka" : zwierze == "koza" ? "burak" : zwierze == "słoń" ? "sorgo" : zwierze == "żyrafa" ? "selerNaciowy" : "";
    private string pokarm2 => zwierze == "krowa" ? "por" : zwierze == "owca" ? "rzodkiewka" : zwierze == "koza" ? "kapustaPekińska" : zwierze == "słoń" ? "arbuz" : zwierze == "żyrafa" ? "mango" : "";
    private string pokarm3 => zwierze == "krowa" ? "gryka" : zwierze == "owca" ? "szpinak" : zwierze == "koza" ? "dynia" : "";
    private async Task OpuscPrzystanek()
    {
        await ladowanieGracza.ZapiszAktualnegoGracza();
        await NaZmianeEkranu.InvokeAsync(EkranGry.ZwierzPuszczaDoSerowLesnych);
        await Task.Delay(6000);
        Gracz.Statystyki.ZwierzeNaDrodze = "";
        await ladowanieGracza.ZapiszAktualnegoGracza();
        await NaZmianeEkranu.InvokeAsync(EkranGry.SeryLesne);
    }
    private async Task Karm1IJedzDalej()
    {
        if (!JestPokarm1()) return;
        if (zwierze == "krowa")
            Gracz.Warzywo("brokuł").Ilosc -= 2;
        else if (zwierze == "koń")
            Gracz.Przedmiot("siano").Ilosc -= 2;
        else if (zwierze == "owca")
            Gracz.Warzywo("brukselka").Ilosc -= 2;
        else if (zwierze == "koza")
            Gracz.Warzywo("burak").Ilosc -= 2;
        else if (zwierze == "słoń")
            Gracz.Warzywo("sorgo").Ilosc -= 2;
        else if (zwierze == "żyrafa")
            Gracz.Warzywo("selerNaciowy").Ilosc -= 2;
        await OpuscPrzystanek();
    }
    private async Task Karm2IJedzDalej()
    {
        if (!JestPokarm2()) return;
        if (zwierze == "krowa")
            Gracz.Warzywo("por").Ilosc -= 2;
        else if (zwierze == "owca")
            Gracz.Warzywo("rzodkiewka").Ilosc -= 2;
        else if (zwierze == "koza")
            Gracz.Warzywo("kapustaPekińska").Ilosc -= 2;
        else if (zwierze == "słoń")
            Gracz.Owoc("arbuz").Ilosc -= 2;
        else if (zwierze == "żyrafa")
            Gracz.Owoc("mango").Ilosc -= 2;
        await OpuscPrzystanek();
    }
    private async Task Karm3IJedzDalej()
    {
        if (!JestPokarm3()) return;
        if (zwierze == "krowa")
            Gracz.Zboze("gryka").Ilosc -= 2;
        else if (zwierze == "owca")
            Gracz.Warzywo("szpinak").Ilosc -= 2;
        else if (zwierze == "koza")
            Gracz.Warzywo("dynia").Ilosc -= 2;
        await OpuscPrzystanek();
    }
    private bool JestPokarm1()
    {
        if (warzywa.Contains(pokarm1))
            return Gracz.JestWarzywo(pokarm1) && Gracz.Warzywo(pokarm1).Ilosc >= 2;
        else
            return Gracz.JestPrzedmiot(pokarm1) && Gracz.Przedmiot(pokarm1).Ilosc >= 2;
    }
    private bool JestPokarm2()
    {
        if (warzywa.Contains(pokarm2))
            return Gracz.JestWarzywo(pokarm2) && Gracz.Warzywo(pokarm2).Ilosc >= 2;
        else
            return Gracz.JestOwoc(pokarm2) && Gracz.Owoc(pokarm2).Ilosc >= 2;
    }
    private bool JestPokarm3()
    {
        if (warzywa.Contains(pokarm3))
            return Gracz.JestWarzywo(pokarm3) && Gracz.Warzywo(pokarm3).Ilosc >= 2;
        else
            return Gracz.JestZboze(pokarm3) && Gracz.Zboze(pokarm3).Ilosc >= 2;
    }
    private string KategoriaPokarmu1()
    {
        if (warzywa.Contains(pokarm1))
            return "warzywa/";
        else
            return "";
    }
    private string KategoriaPokarmu2()
    {
        if (warzywa.Contains(pokarm2))
            return "warzywa/";
        else
            return "owoce/";
    }
    private string KategoriaPokarmu3()
    {
        if (warzywa.Contains(pokarm3))
            return "warzywa/";
        else
            return "zboza/";
    }
    private string SciezkaDoPokarmu1() =>$"img/przedmioty/{KategoriaPokarmu1()}{pokarm1}.png";
    private string SciezkaDoPokarmu2() => $"img/przedmioty/{KategoriaPokarmu2()}{pokarm2}.png";
    private string SciezkaDoPokarmu3() => $"img/przedmioty/{KategoriaPokarmu3()}{pokarm3}.png";
}