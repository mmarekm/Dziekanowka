@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="miastoLesneWidok widok rel">
    <div class="abs miastoLesneNaStacje"><button class="wyroznionyGuzik" @onclick="NaStacje"><img src="img/miasto/miastoLesneNaStacje.png" /></button></div>
    <div class="abs lesneDoFanaZdrowia"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.FanZdrowy)"><img src="img/miasto/lesneDoFanaZdrowego.png" /></button></div>
    <div class="abs miastoLesneDoSerow"><button class="wyroznionyGuzik" @onclick="DoSerowLesnych"><img src="img/miasto/miastoLesneDoSery.png" /></button></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    public async Task NaStacje()
    {
        Gracz.Statystyki.Stacja = "miastoLesne";
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
    }
    public async Task DoSerowLesnych()
    {
        if (Gracz.Statystyki.ZwierzeNaDrodze == "")
            await NaZmianeEkranu.InvokeAsync(EkranGry.SeryLesne);
        else
        {
            await NaZmianeEkranu.InvokeAsync(EkranGry.AutostopDoSerowLesnych);
            await Task.Delay(13000);
            await NaZmianeEkranu.InvokeAsync(EkranGry.PrzystanekDoSerowLesnych);
        }
    }
}