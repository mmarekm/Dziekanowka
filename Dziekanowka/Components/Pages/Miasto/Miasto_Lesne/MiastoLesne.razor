@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="widok powitanie rel">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/miasto/miastoLesneWidok.mp4" type="video/mp4" /></video>
    <div class="abs miastoLesneCel miastoLesneNaStacje"><button class="wyroznionyGuzik" @onclick="NaStacje"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaLesna.png" /></button></div>
    <div class="abs miastoLesneCel lesneDoFanaZdrowia"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.FanZdrowy)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaLesna.png" /></button></div>
    <div class="abs miastoLesneCel miastoLesneDoSerow"><button class="wyroznionyGuzik" @onclick="DoSerowLesnych"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaLesna.png" /></button></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    public async Task NaStacje()
    {
        Gracz.Statystyki.Stacja = "miastoLesne";
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
    }
    public async Task DoSerowLesnych()
    {
        if (Gracz.Statystyki.ZwierzeNaDrodze == "")
            await NaZmianeEkranu.InvokeAsync(EkranGry.SeryLesne);
        else
        {
            await NaZmianeEkranu.InvokeAsync(EkranGry.AutostopDoSerowLesnych);
            await Task.Delay(13000);
            await NaZmianeEkranu.InvokeAsync(EkranGry.PrzystanekDoSerowLesnych);
        }
    }
}