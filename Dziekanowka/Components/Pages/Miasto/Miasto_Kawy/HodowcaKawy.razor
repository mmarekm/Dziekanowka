@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
@inject LadowanieGracza ladowanieGracza
<div class="hodowcaKawyWidok widok rel">
    <div class="abs hodowcaDoMiastaKawy"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.MiastoKawy)"><img class="obrazekContain" src="img/dom/potwierdzenie.png" /></button></div>
    <div class="abs ilustracjaZiarenKawyUHodowcy"><img src="img/dom/kuchnia/ziarnaKawy.png" class="obrazekContain" /></div>
    <div class="abs lZiarenKawyUHodowcy">@Gracz.ZywnoscP("ziarnaKawy").Ilosc</div>
    @if (mozeKupic)
    {
        <div class="abs kupowanieZiarenKawyOdHodowcy @(Gracz.Monety > 14 ? "klikalneDivZielone" : "nieMoznaKliknac")" @onclick="KupZiarnaKawy">
            <div>15</div>
            <img src="img/przedmioty/moneta.png" class="obrazekContain" />
            <img src="img/przedmioty/czarnaStrzalka.png" class="obrazekContain" />
            <img src="img/dom/kuchnia/ziarnaKawy.png" class="obrazekContain" />
        </div>
        <div class="abs lMonetUHodowcy">@Gracz.Monety</div>
        <div class="abs ilustracjaMonetyUHodowcy"><img src="img/przedmioty/moneta.png" class="obrazekContain" /></div>
    }
</div>
@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private bool mozeKupic => (Gracz.ZywnoscP("kawa").Ilosc + Gracz.ZywnoscP("ziarnaKawy").Ilosc) < 3;
    private async Task KupZiarnaKawy()
    {
        if (Gracz.Monety < 15) return;
        Gracz.Monety -= 15;
        Gracz.ZywnoscP("ziarnaKawy").Ilosc++;
        await ladowanieGracza.ZapiszAktualnegoGracza();
    }
}