@using System.Reflection
@using Dziekanowka.Mechanizm
@using Dziekanowka.Mechanizm.JezykiObce
@using Dziekanowka.Gracza
<div class="szkolaJezykiSlownikWidok widok rel">
    <div class="abs hodowcaDoMiastaKawy" style="z-index: 3;"><button class="wyroznionyGuzik" disabled="@wyswietlonaKategoria" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaJezykiIntro)"><img class="obrazekContain" src="img/dom/potwierdzenie.png" /></button></div>
    <div class="abs kategorieSlownik">
        @{
    var fiszki = Fiszki.GetFiszki(wybranaKategoria);
}

@for (int i = 0; i < fiszki.GetLength(1); i++)
{
    <div>
        <div>🇵🇱 @fiszki[0, i]</div>
        <div>🇬🇧 @fiszki[1, i]</div>
        <div>🇪🇸 @fiszki[2, i]</div>
        <div>🏛️ @fiszki[3, i]</div>
    </div>
}
    </div>
    @if (wyswietlonaKategoria)
    {
        <div class="abs wyswietlonaKategoriaSlownik">
            <div class="abs hodowcaDoMiastaKawy" style="z-index: 5;"><button class="wyroznionyGuzik" @onclick="() => wyswietlonaKategoria = false"><img class="obrazekContain" src="img/dom/potwierdzenie.png" /></button></div>
            <!--
            @foreach (var slowo in Fiszki.GetFiszki(wybranaKategoria))
            {
                <div>@slowo</div>
            }
            -->
        </div>
    }
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private bool wyswietlonaKategoria = false;
    private string[] kategorie = Fiszki.KategorieRobocze.Select(x => typeof(Fiszki).GetFields().First(f => f.GetValue(null) == x).Name).ToArray();
    private string wybranaKategoria = "";
    private void PokazSlowka(string kategoria)
    {
        wybranaKategoria = kategoria;
        wyswietlonaKategoria = true;
    }
}
