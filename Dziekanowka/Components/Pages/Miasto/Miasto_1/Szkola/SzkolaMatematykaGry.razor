@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
@implements IDisposable
<div class="szkolaMatematykaGryWidok widok rel">
    <div class="abs hodowcaDoMiastaKawy" style="z-index: 3;"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaMatematykaIntro)"><img class="obrazekContain" src="img/dom/potwierdzenie.png" /></button></div>
    @if (pokazWygrana)
    {
        <div class="abs komunikatWygranaSzkolaMatematyka"><img class="obrazekJakTrzeba" src="img/dom/potwierdzenie.png" /></div>
    }
    else if (powitanie)
    {
        <div class="abs powitanieGra13Plus"><button class="wyroznionyGuzik" @onclick="Startujemy"><img class="obrazekJakTrzeba" src="img/kopalnie/czolowkaKopalniaGliny.png" /></button></div>
    }
    else
    {
        <div class="abs rozgrywkaKopalniaGliny">
            <div class="miernikCzasuKopalniaGliny" @key="rundaId">
                <div class="paskCzasuKopalniaGliny"></div>
            </div>
            <div class="liczbaSzkolaMatematykaGlina">
                @if (aktualnaLiczba != null)
                {
                    @if (pierwszaLiczba)
                    {
                        <span @key="rundaId">@aktualnaLiczba</span>
                    }
                    else
                    {
                        <span @key="rundaId">+ @aktualnaLiczba</span>
                    }
                }
            </div>
            <div class="warunekKopalniaGliny"><img class="obrazekJakTrzeba" src="img/kopalnie/warunekKopalniaGliny.png" /></div>
            <div class="guzikiKopalniaGliny">
                <button class="guzikOdpowiedz @(blyskTak ? "kliknieto" : "")" @onclick="() => Odpowiedz(true)"><img class="obrazekJakTrzeba" src="img/dom/potwierdzenie.png" /></button>
                <button class="guzikOdpowiedz @(blyskNie ? "kliknieto" : "")" @onclick="() => Odpowiedz(false)"><img class="obrazekJakTrzeba" src="img/dom/rezygnacja.png" /></button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private bool blyskTak = false;
    private bool blyskNie = false;
    private bool powitanie = true;
    private int rundaId = 0;
    private int licznik = 13;
    private int? aktualnaLiczba = null;
    private bool pierwszaLiczba = true;
    private bool pokazWygrana = false;
    private CancellationTokenSource? timerCts;
    private async Task Startujemy()
    {
        powitanie = false;
        NowaRunda();
        await Task.CompletedTask;
    }
    private void NowaRunda()
    {
        rundaId++;
        if (pierwszaLiczba)
            aktualnaLiczba = licznik;
        else
        {
            int dodatek = Random.Shared.Next(5, 10);
            licznik += dodatek;
            aktualnaLiczba = dodatek;
        }
        StateHasChanged();
        timerCts = new CancellationTokenSource();
        _ = UruchomTimerOdpowiedzi(timerCts.Token);
    }
    private async Task UruchomTimerOdpowiedzi(CancellationToken token)
    {
        try
        {
            await Task.Delay(7000, token);
            await Odpowiedz(false);
        }
        catch (TaskCanceledException) { }
    }
    private async Task ResetBlysk(bool tak)
    {
        await Task.Delay(300);
        if (tak) blyskTak = false; else blyskNie = false;
        StateHasChanged();
    }
    private async Task Odpowiedz(bool graczUwazaZeWystarczy)
    {
        if (graczUwazaZeWystarczy) blyskTak = true; else blyskNie = true;
        StateHasChanged();
        _ = ResetBlysk(graczUwazaZeWystarczy);
        timerCts?.Cancel();
        bool faktycznieWystarczy = licznik >= 77;
        if (graczUwazaZeWystarczy == faktycznieWystarczy)
        {
            if (faktycznieWystarczy)
            {
                pokazWygrana = true;
                StateHasChanged();
                await Task.Delay(750);
                pokazWygrana = false;
                KoniecGry();
            }
            else
            {
                pierwszaLiczba = false;
                NowaRunda();
            }
        }
        else
            KoniecGry();
    }
    private void KoniecGry()
    {
        rundaId = 0;
        licznik = 13;
        pierwszaLiczba = true;
        powitanie = true;
    }
    public void Dispose()
    {
        timerCts?.Cancel();
    }
}