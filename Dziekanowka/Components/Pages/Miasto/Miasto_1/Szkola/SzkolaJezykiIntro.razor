@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="widok powitanie rel">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/miasto/szkola/szkolaJezykiIntroWidok.mp4" type="video/mp4" /></video>
    <div class="abs szkolaCel szkolaJezykiIntroDoIntro"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaIntro)"><img class="obrazekJakTrzeba" src="img/miasto/szkola/strzalkaSzkola.png" /></button></div>
    <div class="abs szkolaCel szkolaJezykiIntroDoPortier"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaJezykiPortier)"><img class="obrazekJakTrzeba" src="img/miasto/szkola/strzalkaSzkola.png" /></button></div>
    <div class="abs szkolaCel szkolaJezykiIntroDoSlownik"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaJezykiSlownik)"><img class="obrazekJakTrzeba" src="img/miasto/szkola/strzalkaSzkola.png" /></button></div>
    <div class="abs szkolaCel szkolaJezykiIntroDoGry"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaJezykiGry)"><img class="obrazekJakTrzeba" src="img/miasto/szkola/strzalkaSzkola.png" /></button></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
}