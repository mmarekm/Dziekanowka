@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="szkolaJezykiIntroWidok widok rel">
    <div class="abs szkolaJezykiIntroDoIntro"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaIntro)"><img src="img/miasto/szkola/szkolaJezykiIntroDoIntro.png" /></button></div>
    <div class="abs szkolaJezykiIntroDoPortier"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaJezykiPortier)"><img src="img/miasto/szkola/szkolaJezykiIntroDoPortier.png" /></button></div>
    <div class="abs szkolaJezykiIntroDoSlownik"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaJezykiSlownik)"><img src="img/miasto/szkola/szkolaJezykiIntroDoSlownik.png" /></button></div>
    <div class="abs szkolaJezykiIntroDoGry"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SzkolaJezykiGry)"><img src="img/miasto/szkola/szkolaJezykiIntroDoGry.png" /></button></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
}