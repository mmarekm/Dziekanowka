@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="widok powitanie rel">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/miasto/miastoWiejskieWidok.mp4" type="video/mp4" /></video>
    <div class="abs miastoWiejskieCel miastoWiejskieNaStacje"><button class="wyroznionyGuzik" @onclick="NaStacje"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaWiejska.png" /></button></div>
    <div class="abs miastoWiejskieCel miastoWiejskieDoDzieciCiekawe"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.DzieciCiekawe)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaWiejska.png" /></button></div>
    <div class="abs miastoWiejskieCel miastoWiejskieDoSurowkaKwiaty"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.WiesSurowkaKwiaty)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaWiejska.png" /></button></div>
</div>
@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    public async Task NaStacje()
    {
        Gracz.Statystyki.Stacja = "miastoWiejskie";
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
    }
}