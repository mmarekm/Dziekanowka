@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
@inject LadowanieGracza ladowanieGracza
<div class="widok powitanie rel">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/miasto/miastoGorskie/domPlatkowWidok.mp4" type="video/mp4" /></video>
    <div class="abs hodowcaDoMiastaKawy"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.MiastoGorskie)"><img class="obrazekContain" src="img/dom/potwierdzenie.png" /></button></div>
    <div class="abs kiosk1Puchar @(Gracz.Statystyki.MoznaOdebracObraz ? "poblyskuje" : "")"><img src="img/przedmioty/medalRestauracyjny@(sciezkaPucharu)Zdobyty.png" /></div>
    @if (Gracz.Statystyki.AktualnaMisja == Misje.PlatkiGorskie)
    {
        <div class="abs potrzebneSniadanieGoralowi @(saPlatki ? "klikalneDivZielone" : "nieMoznaKliknac")" @onclick="DajPlatki"></div>
        <div class="abs potrzebneMlekoGoralowi"><img class="obrazekContain" src="img/dom/kuchnia/@(Gracz.Statystyki.DaneMisji[0]).png" /></div>
        <div class="abs potrzebnePlatkiGoralowi">3 <img class="obrazekContain" src="img/przedmioty/przetwornia/@(Gracz.Statystyki.DaneMisji[1]).png" /></div>
    }
</div>
@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private string sciezkaPucharu => Gracz.Statystyki.MoznaOdebracObraz ? "" : "Nie";
    private bool saPlatki => Gracz.Statystyki.AktualnaMisja == Misje.PlatkiGorskie && Gracz.JestProduktZ(Gracz.Statystyki.DaneMisji[0]) && Gracz.JestProduktP(Gracz.Statystyki.DaneMisji[1]) && Gracz.ProduktP(Gracz.Statystyki.DaneMisji[1]).Ilosc > 2;
    private async Task DajPlatki()
    {
        if (!saPlatki) return;
        Gracz.ProduktZ(Gracz.Statystyki.DaneMisji[0]).Ilosc--;
        Gracz.ProduktP(Gracz.Statystyki.DaneMisji[1]).Ilosc -= 3;
        Gracz.LosujNowaMisje();
        await NaZmianeEkranu.InvokeAsync(EkranGry.ZjedzaPlatki);
        await Task.Delay(9000);
        await NaZmianeEkranu.InvokeAsync(EkranGry.GorskiePlatki);
        await ladowanieGracza.ZapiszAktualnegoGracza();
    }
}