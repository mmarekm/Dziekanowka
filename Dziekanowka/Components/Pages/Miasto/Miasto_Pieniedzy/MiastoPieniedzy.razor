@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="miastoPieniedzyWidok widok rel">
    <div class="abs miastoPieniedzyNaStacje"><button class="wyroznionyGuzik" @onclick="NaStacje"><img src="img/miasto/miastoPieniedzyNaStacje.png" /></button></div>
    <div class="abs miastoDoBanku"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Bank)"><img src="img/miasto/miastoPieniedzy/miastoDoBanku.png" /></button></div>
    <div class="abs miastoNaGielde"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Gielda)"><img src="img/miasto/miastoPieniedzy/miastoNaGielde.png" /></button></div>
    <div class="abs miastoPieniedzyDoRatusza"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Ratusz)"><img src="img/miasto/miastoPieniedzy/miastoPieniedzyDoRatusza.png" /></button></div>
</div>
@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    public async Task NaStacje()
    {
        Gracz.Statystyki.Stacja = "miastoPieniedzy";
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
    }
}