@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="widok powitanie rel">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/miasto/miastoPieniedzyWidok.mp4" type="video/mp4" /></video>
    <div class="abs miastoPieniedzyCel miastoPieniedzyNaStacje"><button class="wyroznionyGuzik" @onclick="NaStacje"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaPieniedzy.png" /></button></div>
    <div class="abs miastoPieniedzyCel miastoDoBanku"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Bank)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaPieniedzy.png" /></button></div>
    <div class="abs miastoPieniedzyCel miastoNaGielde"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Gielda)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaPieniedzy.png" /></div>
    <div class="abs miastoPieniedzyCel miastoPieniedzyDoRatusza"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Ratusz)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaPieniedzy.png" /></button></div>
</div>
@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    public async Task NaStacje()
    {
        Gracz.Statystyki.Stacja = "miastoPieniedzy";
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
    }
}