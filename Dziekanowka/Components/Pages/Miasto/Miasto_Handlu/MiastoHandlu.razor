@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
@inject LadowanieGracza ladowanieGracza
@implements IDisposable
<div class="widok powitanie rel ovHidden">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/miasto/miastoHandluWidok.mp4" type="video/mp4" /></video>
    <div class="abs miastoHandluCel miastoHandluNaStacje"><button class="wyroznionyGuzik" @onclick="NaStacje"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaHandlu.png" /></button></div>
    <div class="abs miastoHandluCel miastoHandluDoTargowiskoBilety"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.TargowiskoBilety)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaHandlu.png" /></button></div>
    <div class="abs miastoHandluCel miastoHandluDoTargowiskoGlina"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.TargowiskoGlina)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaHandlu.png" /></button></div>
    <div class="abs miastoHandluCel miastoHandluDoTargowiskoTrzcina"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.TargowiskoTrzcina)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaHandlu.png" /></button></div>
    <div class="abs autobusAnimacjaTargowisko @klasaAutobusu" @onclick="WsiadzDoAutobusu"><img class="obrazekWypelnia" src="img/miasto/miastoHandlu/drewnianyAutobus.png" /></div>
    <div class="abs stanBiletuMiastoHandlu"><img src="img/przedmioty/biletAutobusTargowisko@(jestBilet ? "" : "Nie").png" class="obrazekJakTrzeba" /></div>
</div>
@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private string klasaAutobusu = "autobusUkrytyTargowisko";
    private bool moznaWsiasc = false;
    private bool jestBilet => Gracz.Statystyki.Bonusy.Contains("biletAutobusTargowisko");
    private CancellationTokenSource? _cts;
    protected override void OnInitialized()
    {
        _ = PetlaAutobusu();
    }
    private async Task PetlaAutobusu()
    {
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(6000, token);
                klasaAutobusu = "autobusJedzieEtap1Targowisko";
                moznaWsiasc = false;
                StateHasChanged();
                await Task.Delay(2420, token);
                klasaAutobusu = "autobusJedzieEtap2Targowisko";
                StateHasChanged();
                await Task.Delay(3080, token);
                klasaAutobusu = "autobusStoiTargowisko";
                moznaWsiasc = true;
                StateHasChanged();
                await Task.Delay(4000, token);
                moznaWsiasc = false;
                klasaAutobusu = "autobusOdjedzieEtap1Targowisko";
                StateHasChanged();
                await Task.Delay(3080, token);
                klasaAutobusu = "autobusOdjedzieEtap2Targowisko";
                StateHasChanged();
                await Task.Delay(2420, token);
                klasaAutobusu = "autobusUkrytyTargowisko";
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }
    public async Task NaStacje()
    {
        Gracz.Statystyki.Stacja = "miastoHandlu";
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
    }
    public async Task WsiadzDoAutobusu()
    {
        if (!moznaWsiasc || !jestBilet) return;
        Gracz.Statystyki.Bonusy.Remove("biletAutobusTargowisko");
        await ladowanieGracza.ZapiszAktualnegoGracza();
        await NaZmianeEkranu.InvokeAsync(EkranGry.AutobusTargowisko);
        await Task.Delay(10000);
        await NaZmianeEkranu.InvokeAsync(EkranGry.DrewnianaOaza);
    }
    public void Dispose()
    {
        _cts?.Cancel();
    }
}