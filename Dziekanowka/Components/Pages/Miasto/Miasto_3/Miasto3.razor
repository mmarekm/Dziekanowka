@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
@inject LadowanieGracza ladowanieGracza
@implements IDisposable
<div class="widok powitanie rel ovHidden">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/miasto/miasto3.mp4" type="video/mp4" /></video>
    <div class="abs lBiletowMiasto3 dCenter">@Gracz.Przedmiot("biletAutobus").Ilosc</div>
    <div class="abs autobusAnimacjaM3 @klasaAutobusu" @onclick="WsiadzDoAutobusu"><img class="obrazekWypelnia" src="img/miasto/autobus.png" /></div>
    <div class="abs miastoCel miasto3doSklepBydlo"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SklepBydlo)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaMiasto.png" /></button></div>
    <div class="abs miastoCel miasto3DoKiosk"><button class="wyroznionyGuzik" @onclick="DoKiosku"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaMiasto.png" /></button></div>
    <div class="abs miastoCel miasto3DoSklep"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.SklepMiasto3)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaMiasto.png" /></button></div>
    <div class="abs miastoCel miasto3DoApteka"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Apteka)"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaMiasto.png" /></button></div>
    <div class="abs miastoCel miasto3NaStacje"><button class="wyroznionyGuzik" @onclick="NaStacje"><img class="obrazekJakTrzeba" src="img/miasto/strzalkaMiasto.png" /></button></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private string klasaAutobusu = "autobusUkryty";
    private bool moznaWsiasc = false;
    private CancellationTokenSource? _cts;
    protected override void OnInitialized()
    {
        _ = PetlaAutobusu();
    }
    private async Task PetlaAutobusu()
    {
        _cts = new CancellationTokenSource();
        var token = _cts.Token;
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(5000, token);
                klasaAutobusu = "autobusJedzieM3";
                moznaWsiasc = false;
                StateHasChanged();
                await Task.Delay(1000, token);
                klasaAutobusu = "autobusStoiM3";
                moznaWsiasc = true;
                StateHasChanged();
                await Task.Delay(2000, token);
                moznaWsiasc = false;
                klasaAutobusu = "autobusOdjedzieM3";
                StateHasChanged();
                await Task.Delay(1000, token);
                klasaAutobusu = "autobusUkrytyM3";
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }
    public async Task DoKiosku()
    {
        Gracz.Statystyki.Kiosk = 3;
        await NaZmianeEkranu.InvokeAsync(EkranGry.Kiosk);
    }
    public async Task NaStacje()
    {
        Gracz.Statystyki.Stacja = "miasto3";
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
    }
    public async Task WsiadzDoAutobusu()
    {
        if (Gracz.Przedmiot("biletAutobus").Ilosc < 1 || !moznaWsiasc) return;
        Gracz.Przedmiot("biletAutobus").Ilosc--;
        await NaZmianeEkranu.InvokeAsync(EkranGry.AutobusJedzie3);
        await Task.Delay(8000);
        await NaZmianeEkranu.InvokeAsync(EkranGry.Miasto2);
    }
    public void Dispose()
    {
        _cts?.Cancel();
    }
}
