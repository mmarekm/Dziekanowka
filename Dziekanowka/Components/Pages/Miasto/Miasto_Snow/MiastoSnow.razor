@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="widok powitanie rel">
    <video class="tlo-wideo" autoplay muted loop playsinline preload="auto"><source src="img/miasto/miastoSnow/miastoSnowWidok.mp4" type="video/mp4" /></video>
    <div class="abs miastoSnowCel miastoSnowNaStacje"><button class="wyroznionyGuzik" @onclick="NaStacje"><img class="obrazekJakTrzeba" src="img/miasto/miastoSnow/strzalkaSny.png" /></button></div>
    <div class="abs miastoSnowCel miastoSnowDoOczekujacyPiorIFuter"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.OczekujacyPiorIFuter)"><img class="obrazekJakTrzeba" src="img/miasto/miastoSnow/strzalkaSny.png" /></button></div>
    <div class="abs miastoSnowCel miastoSnowDoInfoMisja"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.InfoMisjaSny)"><img class="obrazekJakTrzeba" src="img/miasto/miastoSnow/strzalkaSny.png" /></button></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    public async Task NaStacje()
    {
        Gracz.Statystyki.Stacja = "miastoSnow";
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
    }
}