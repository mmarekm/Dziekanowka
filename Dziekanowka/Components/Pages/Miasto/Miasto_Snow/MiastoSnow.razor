@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="miastoSnowWidok widok rel">
    <div class="abs miastoSnowNaStacje"><button class="wyroznionyGuzik" @onclick="NaStacje"><img src="img/miasto/miastoSnowNaStacje.png" /></button></div>
    <div class="abs miastoSnowDoOczekujacyPiorIFuter"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.DomMleka)"><img src="img/miasto/miastoDoDomMleka.png" /></button></div>
    <div class="abs miastoSnowDoInfoMisja"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.ManufakturaPiorIFuter)"><img src="img/miasto/miastoBialeDoManufaktury.png" /></button></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    public async Task NaStacje()
    {
        Gracz.Statystyki.Stacja = "miastoSnow";
        await NaZmianeEkranu.InvokeAsync(EkranGry.Stacja);
    }
}