@using Dziekanowka.Mechanizm
@using Dziekanowka.Gracza
<div class="widok rel" style="background-image: url('../img/dom/ogrod/ogrod@(poziom).png');">
    <div class="abs wiesSurowkaKwiatyWyjscie"><button class="wyroznionyGuzik" @onclick="async () => await NaZmianeEkranu.InvokeAsync(EkranGry.Gospodarstwo)"><img class="obrazekContain" src="img/dom/potwierdzenie.png" /></button></div>
</div>

@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private int poziom => Gracz.Statystyki.Ogrodek;
}