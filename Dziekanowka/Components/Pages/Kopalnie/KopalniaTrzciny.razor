@using Dziekanowka.Mechanizm
@using Dziekanowka.Mechanizm.JezykiObce
@using Dziekanowka.Gracza
@inject LadowanieGracza ladowanieGracza
<div class="kopalniaTrzcinyWidok widok rel">
    @if (powitanie)
    {
        <div class="abs startKopalniaTrzciny" @onclick="StartPoszukiwan"><button class="wyroznionyGuzik"><img class="obrazekJakTrzeba" src="img/kopalnie/startKopalniaTrzcina.png"/></button></div>
    }
    else
    {
        
    }
</div>
@code {
    [Parameter] public Gracz Gracz { get; set; } = null!;
    [Parameter] public EventCallback<EkranGry> NaZmianeEkranu { get; set; }
    private bool powitanie = true;
    private void StartPoszukiwan()
    {
        powitanie = false;

    }
    private async Task Wygrana()
    {
        Gracz.Przedmiot("walutaTrzcina").Ilosc += 3;
        await ladowanieGracza.ZapiszAktualnegoGracza();
        Gracz.Statystyki.OtwarteOkno = "wygranaTrzcina_3";
        await NaZmianeEkranu.InvokeAsync(EkranGry.KopalniaTrzcinyWygrana);
        //await Task.Delay(8000);
        await NaZmianeEkranu.InvokeAsync(EkranGry.LasRodzinaRybakow);
    }
    private async Task Remis()
    {
        Gracz.Przedmiot("walutaTrzcina").Ilosc ++;
        await ladowanieGracza.ZapiszAktualnegoGracza();
        Gracz.Statystyki.OtwarteOkno = "wygranaTrzcina_1";
        await NaZmianeEkranu.InvokeAsync(EkranGry.KopalniaTrzcinyRemis);
        await Task.Delay(10000);
        await NaZmianeEkranu.InvokeAsync(EkranGry.LasRodzinaRybakow);
    }
    private async Task Przegrana()
    {
        await NaZmianeEkranu.InvokeAsync(EkranGry.KopalniaTrzcinyPrzegrana);
        await Task.Delay(8000);
        await NaZmianeEkranu.InvokeAsync(EkranGry.LasRodzinaRybakow);
    }
}