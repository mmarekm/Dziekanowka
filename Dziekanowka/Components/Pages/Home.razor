@page "/"
@using Dziekanowka.Mechanizm
@inject LadowanieGracza ladowanieGracza
@inject Dzwieki dzwieki
@implements IDisposable
@using System.Text.Json
@if (pokazWideo)
{
    <WidePowitalne />
}
else
{
    <div class="kontener @(czyAnimacjaWyjscia ? "fade-out" : "fade-in")">
        <DynamicComponent Type="@GetComponentType()" Parameters="@GetParameters()" />
        @if (aktualnyEkran != EkranGry.Start)
        {
            <div class="abs @KlasaPowitania">
                <img class="obrazekWypelnia" src="img/przedmioty/moneta.png" />
                <img class="obrazekWypelnia" src="img/przedmioty/moneta.png" />
                Witaj! @gracz!.Statystyki.BonusDzienny + @gracz.Przedmiot("siano").Ilosc
                <img class="obrazekWypelnia" src="img/przedmioty/moneta.png" />
                <img class="obrazekWypelnia" src="img/przedmioty/moneta.png" />
            </div>
            @if (!czekaNaPowitanie)
            {
                <div class="powrotMenu" @onclick="Menu"></div>
            }
        }
    </div>
}

@code {
    private EkranGry aktualnyEkran = EkranGry.Start;
    private bool czyAnimacjaWyjscia = false;
    private EkranGry nastepnyEkran;
    private Gracz? gracz => ladowanieGracza.AktualnyGracz;
    private bool pokazWideo = false;
    private readonly HashSet<EkranGry> ekranyBezParametrow = [ EkranGry.AnimacjaTraktora, EkranGry.AnimacjaTraktoraPowrot, EkranGry.CzyszczeniePola, EkranGry.CzyszczenieDrzewa, EkranGry.GrzybyZnalezione, EkranGry.RybaZlowiona,
        EkranGry.PsySasiadaSzczekaja, EkranGry.KoszenieTrawy, EkranGry.SamochodDoMiasta, EkranGry.SamochodDoDomu, EkranGry.PtaszkiZjedza, EkranGry.AutobusJedzie, EkranGry.AutobusJedzie21, EkranGry.AutobusJedzie22, EkranGry.AutobusJedzie3, EkranGry.PociagJedzie,
        EkranGry.GarnekGotowanie, EkranGry.PatelniaSmazenie, EkranGry.PieczenieChleba, EkranGry.PieczenieCiasta, EkranGry.PieczenieWedliny, EkranGry.MaselnicaPraca, EkranGry.SerowarniaPraca, EkranGry.ZarnaPraca, EkranGry.PlatkarkaPraca,
        EkranGry.BeczkaPraca, EkranGry.MlynekPraca, EkranGry.WyciskarkaPraca, EkranGry.KawaPraca, EkranGry.WejscieDoGalerii, EkranGry.UzyskanieObrazu, EkranGry.ChlopiecZje, EkranGry.KotZje, EkranGry.FanZdrowyRadosc, EkranGry.BabciaDajeKwiaty,
        EkranGry.MlekoLeciWDomMleka, EkranGry.KuchniaPracuje, EkranGry.WinoMorskieDlaPlebana, EkranGry.WniesionoBuleczke, EkranGry.LesneMyszyZjedza, EkranGry.BonusZaOwce, EkranGry.DzieciCiekaweCiesza, EkranGry.ZjedzaPlatki, EkranGry.CiastoDlaStajennego,
        EkranGry.PociagCzarnyDoTunelu, EkranGry.PociagCzarnyZTunelu, EkranGry.KlaunNalewaKawe, EkranGry.DoczekalPiorIFuter, EkranGry.SzyjeZPiorIFutra, EkranGry.SprzedajeTowarZGliny, EkranGry.BiletWStodole, EkranGry.WjazdStacjaKopalnie, EkranGry.WyjazdStacjaKopalnie];
    private Type GetComponentType() => Type.GetType(aktualnyEkran.ToString()) ?? GetType().Assembly.GetTypes().FirstOrDefault(t => t.Name == aktualnyEkran.ToString())!;
    private Dictionary<string, object>? GetParameters() => ekranyBezParametrow.Contains(aktualnyEkran) ? null : aktualnyEkran == EkranGry.Start ? new() { ["NaStartGry"] = EventCallback.Factory.Create<string>(this, WywolajStartGry) } : new() { ["Gracz"] = gracz!, ["NaZmianeEkranu"] = EventCallback.Factory.Create<EkranGry>(this, ZmienEkran) };
    private bool Powitaj { get; set; } = false;
    private bool Znikanie { get; set; } = false;
    private bool czekaNaPowitanie = false;
    private string KlasaPowitania => Powitaj ? (Znikanie ? "powitanieDzienne znikaj" : "powitanieDzienne") : "ukryty";
    protected override void OnInitialized()
    {
        Dzwieki.Dzwiek = dzwieki;
        ladowanieGracza.NowyDzienEvent += OnNowyDzien;
        dzwieki.WideoPowitalneZakonczoneEvent += OnWideoPowitalneZakonczone;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await GraTlo(EkranGry.Start);
        if (czekaNaPowitanie && aktualnyEkran != EkranGry.Start)
        {
            czekaNaPowitanie = false;
            await PowitanieDnia();
        }
    }
    private void OnNowyDzien()
    {
        czekaNaPowitanie = true;
    }
    private static EkranGry PrecyzujEkranStartowy(EkranGry ekran) => ekran switch
    {
        EkranGry.AnimacjaTraktora or EkranGry.AnimacjaTraktoraPowrot => EkranGry.Gospodarstwo,
        EkranGry.CzyszczeniePola or EkranGry.CzyszczenieDrzewa => EkranGry.PoleIntro,
        EkranGry.PsySasiadaSzczekaja or EkranGry.SamochodDoMiasta or EkranGry.SamochodDoDomu => EkranGry.ZaBrama,
        EkranGry.KoszenieTrawy => EkranGry.GarazGospodarczy,
        EkranGry.PtaszkiZjedza or EkranGry.GarnekGotowanie or EkranGry.PatelniaSmazenie or EkranGry.PieczenieChleba or EkranGry.PieczenieCiasta or EkranGry.PieczenieWedliny or EkranGry.WyciskarkaPraca or EkranGry.KawaPraca => EkranGry.DomKuchnia,
        EkranGry.MaselnicaPraca or EkranGry.SerowarniaPraca or EkranGry.ZarnaPraca or EkranGry.PlatkarkaPraca or EkranGry.BeczkaPraca or EkranGry.MlynekPraca => EkranGry.Przetwornia,
        EkranGry.LasGrzyby or EkranGry.GrzybyZnalezione => EkranGry.LasIntro,
        EkranGry.AutobusJedzie or EkranGry.AutobusJedzie21 => EkranGry.Miasto1,
        EkranGry.AutobusJedzie22 or EkranGry.AutobusJedzie3 => EkranGry.Miasto2,
        EkranGry.PociagJedzie or EkranGry.PociagCzarnyDoTunelu or EkranGry.PociagCzarnyZTunelu or EkranGry.WyjazdStacjaKopalnie => EkranGry.Stacja,
        EkranGry.RybaZlowiona => EkranGry.LasJezioro,
        EkranGry.WejscieDoGalerii => EkranGry.BibliotekaIntro,
        EkranGry.UzyskanieObrazu => EkranGry.BibliotekaPani,
        EkranGry.ChlopiecZje or EkranGry.KotZje => EkranGry.Kiosk,
        EkranGry.FanZdrowyRadosc => EkranGry.FanZdrowy,
        EkranGry.AutostopDoSerowLesnych or EkranGry.ZwierzPuszczaDoSerowLesnych => EkranGry.MiastoLesne,
        EkranGry.MlekoLeciWDomMleka => EkranGry.DomMleka,
        EkranGry.KuchniaPracuje => EkranGry.KuchniaMorska,
        EkranGry.WinoMorskieDlaPlebana => EkranGry.MiastoMorskie,
        EkranGry.WniesionoBuleczke => EkranGry.DomSlodkichBulek,
        EkranGry.LesneMyszyZjedza => EkranGry.SeryLesne,
        EkranGry.BonusZaOwce => EkranGry.OwceGorskie,
        EkranGry.ZjedzaPlatki => EkranGry.GorskiePlatki,
        EkranGry.CiastoDlaStajennego => EkranGry.Stajenny,
        EkranGry.DzieciCiekaweCiesza => EkranGry.DzieciCiekawe,
        EkranGry.BabciaDajeKwiaty => EkranGry.WiesSurowkaKwiaty,
        EkranGry.KlaunNalewaKawe => EkranGry.PotrzebaKawy,
        EkranGry.SzyjeZPiorIFutra => EkranGry.ManufakturaPiorIFuter,
        EkranGry.DoczekalPiorIFuter => EkranGry.OczekujacyPiorIFuter,
        EkranGry.SprzedajeTowarZGliny => EkranGry.TargowiskoGlina,
        EkranGry.BiletWStodole => EkranGry.Stodola,
        EkranGry.WjazdStacjaKopalnie or EkranGry.KopalniaGliny => EkranGry.StacjaKopalnie,
        _ => ekran
    };
    private async void OnWideoPowitalneZakonczone()
    {
        pokazWideo = false;
        StateHasChanged();
        await ZmienEkran(PrecyzujEkranStartowy(gracz!.Statystyki.Ekran));
    }
    private async Task PowitanieDnia()
    {
        Powitaj = true;
        Znikanie = false;
        StateHasChanged();
        await Task.Delay(100);
        Znikanie = true;
        StateHasChanged();
        await Task.Delay(3000);
        Powitaj = false;
        Znikanie = false;
        StateHasChanged();
    }
    public void Dispose()
    {
        ladowanieGracza.NowyDzienEvent -= OnNowyDzien;
        dzwieki.WideoPowitalneZakonczoneEvent -= OnWideoPowitalneZakonczone;
    }
    private static bool JestLasem(EkranGry ekran)
    {
        var nazwa = ekran.ToString();
        return nazwa.Length > 3 && nazwa.StartsWith("Las") && nazwa.Substring(3).All(char.IsDigit);
    }
    private Task GraTlo(EkranGry ekran)
    {
        var sciezka = ekran switch
        {
            EkranGry.Stajenny => "mp3/Tla/stajnia.mp3",
            EkranGry.DomWiatrolap or EkranGry.DomSalon or EkranGry.DomKuchnia or EkranGry.KawaPraca or EkranGry.DomSciagawka => "mp3/Tla/dom.mp3",
            EkranGry.PoleIntro or EkranGry.Pole1 or EkranGry.Pole2 or EkranGry.Sad1 or EkranGry.Sad2 => "mp3/Tla/poleIntro.mp3",
            EkranGry.AnimacjaTraktora or EkranGry.AnimacjaTraktoraPowrot or EkranGry.SamochodDoMiasta or EkranGry.SamochodDoDomu or EkranGry.AutobusJedzie or EkranGry.AutobusJedzie21 or EkranGry.AutobusJedzie22 or EkranGry.AutobusJedzie3 => "mp3/Tla/traktorJazda.mp3",
            EkranGry.Garaz or EkranGry.GarazGospodarczy => "mp3/Tla/garazgospodarczy.mp3",
            EkranGry.LasIntro => "mp3/Tla/las.mp3",
            var e when JestLasem(e) => "mp3/Tla/las.mp3",
            EkranGry.DomSlodkichBulek => "mp3/Tla/miejsceLas.mp3",
            EkranGry.SzkolaIntro => "mp3/Tla/szkola.mp3",
            EkranGry.BibliotekaIntro or EkranGry.BibliotekaCzytelnia or EkranGry.BibliotekaGaleria or EkranGry.WejscieDoGalerii or EkranGry.BibliotekaPani => "mp3/Tla/biblioteka.mp3",
            EkranGry.Stacja or EkranGry.PociagJedzie or EkranGry.PociagCzarnyDoTunelu or EkranGry.PociagCzarnyZTunelu or EkranGry.WjazdStacjaKopalnie => "mp3/Tla/kolej.mp3",
            EkranGry.GrzybyZnalezione or EkranGry.RybaZlowiona or EkranGry.UzyskanieObrazu or EkranGry.BonusZaOwce or EkranGry.DzieciCiekaweCiesza or EkranGry.BabciaDajeKwiaty or EkranGry.BiletWStodole => "mp3/Dzwieki/fanfaraKrotka.mp3",
            EkranGry.GarnekGotowanie or EkranGry.PatelniaSmazenie or EkranGry.PieczenieChleba or EkranGry.PieczenieCiasta or EkranGry.PieczenieWedliny or EkranGry.MaselnicaPraca or EkranGry.SerowarniaPraca or EkranGry.ZarnaPraca or EkranGry.PlatkarkaPraca or EkranGry.BeczkaPraca or EkranGry.MlynekPraca or EkranGry.WyciskarkaPraca or EkranGry.WinoMorskieDlaPlebana or EkranGry.SzyjeZPiorIFutra or EkranGry.SprzedajeTowarZGliny=> "mp3/Tla/akcjaSprawna.mp3",
            EkranGry.FanZdrowy or EkranGry.AutostopDoSerowLesnych or EkranGry.PrzystanekDoSerowLesnych or EkranGry.ZwierzPuszczaDoSerowLesnych or EkranGry.SeryLesne => "mp3/Tla/miastolesne.mp3",
            EkranGry.DomMleka or EkranGry.ManufakturaPiorIFuter => "mp3/Tla/miastobiale.mp3",
            EkranGry.KuchniaMorska => "mp3/Tla/miastomorskie.mp3",
            EkranGry.GorskiePlatki or EkranGry.OwceGorskie => "mp3/Tla/miastogorskie.mp3",
            EkranGry.DzieciCiekawe or EkranGry.WiesSurowkaKwiaty => "mp3/Tla/miastowiejskie.mp3",
            EkranGry.PotrzebaKawy or EkranGry.HodowcaKawy => "mp3/Tla/miastokawy.mp3",
            EkranGry.OczekujacyPiorIFuter or EkranGry.InfoMisjaSny => "mp3/Tla/miastosnow.mp3",
            EkranGry.TargowiskoBilety or EkranGry.TargowiskoGlina => "mp3/Tla/miastohandlu.mp3",
            EkranGry.WyjazdStacjaKopalnie => "mp3/Tla/stacjakopalnie.mp3",
            EkranGry.ChlopiecZje or EkranGry.KotZje or EkranGry.FanZdrowyRadosc or EkranGry.MlekoLeciWDomMleka or EkranGry.KuchniaPracuje or EkranGry.WniesionoBuleczke or EkranGry.LesneMyszyZjedza or EkranGry.ZjedzaPlatki or EkranGry.CiastoDlaStajennego or EkranGry.KlaunNalewaKawe or EkranGry.DoczekalPiorIFuter => "mp3/Dzwieki/fanfara.mp3",
            EkranGry.CzyszczeniePola or EkranGry.CzyszczenieDrzewa or EkranGry.PtaszkiZjedza => null,
            _ => $"mp3/Tla/{ekran.ToString().ToLower()}.mp3"
        };
        return sciezka != null ? dzwieki.GraTlo(sciezka) : Task.CompletedTask;
    }
    private async Task ZmienEkran(EkranGry ekran)
    {
        gracz!.Statystyki.Ekran = ekran;
        await ladowanieGracza.ZapiszAktualnegoGracza();
        nastepnyEkran = ekran;
        czyAnimacjaWyjscia = true;
        StateHasChanged();
        await Task.Delay(300);
        aktualnyEkran = nastepnyEkran;
        czyAnimacjaWyjscia = false;
        StateHasChanged();
        await GraTlo(ekran);
        await Task.Delay(10);
    }
    private async Task WywolajStartGry(string nazwaGracza)
    {
        await ladowanieGracza.ZaladujGracza(nazwaGracza);
        if (ladowanieGracza.CzyPokazacWideo)
        {
            pokazWideo = true;
            StateHasChanged();
            return;
        }
        await ZmienEkran(PrecyzujEkranStartowy(gracz!.Statystyki.Ekran));
    }
    private async Task Menu()
    {
        aktualnyEkran = EkranGry.Start;
        await GraTlo(EkranGry.Start);
    }
}